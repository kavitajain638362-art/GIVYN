{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build -- --mode vercel",
      "devCommand": "npm run dev -- --mode vercel",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(?!api(?:/|$)|assets(?:/|$)).*", "dest": "/index.html" }
      ]
    },
    "gateway": {
      "root": "gateway",
      "framework": "express",
      "entrypoint": "app.js",
      "bindings": [
        { "type": "service", "service": "app", "format": "url", "env": "GIVYN_API_URL" }
      ]
    },
    "app": {
      "root": ".",
      "framework": "flask",
      "entrypoint": "app:app",
      "buildCommand": "python backend/fetch_models.py",
      "functions": {
        "app.py": {
          "includeFiles": "backend/{knowledge_base.json,models/**}",
          "excludeFiles": "{frontend,gateway,training,tests,instance,.venv}/**"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "gateway" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
